volume=2.0

<region>
sample=Alto_Sax_Ensemble__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=2.9

<region>
sample=Alto_Sax_Ensemble__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-1.6

<region>
sample=Alto_Sax_Ensemble__84.flac
