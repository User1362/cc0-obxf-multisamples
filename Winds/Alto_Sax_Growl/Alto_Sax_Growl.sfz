// Alto Sax Growl — multisample render of a CC0 OB-Xf patch (Winds). See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=Alto_Sax_Growl__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=1.0

<region>
sample=Alto_Sax_Growl__48.flac
lokey=43 hikey=54 pitch_keycenter=48
volume=2.2

<region>
sample=Alto_Sax_Growl__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=1.5

<region>
sample=Alto_Sax_Growl__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=0.0

<region>
sample=Alto_Sax_Growl__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=3.9
