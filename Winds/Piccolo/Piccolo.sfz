volume=2.1

<region>
sample=Piccolo__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=3.3

<region>
sample=Piccolo__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=2.7
