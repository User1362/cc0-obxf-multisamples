volume=0.8

<region>
sample=Mission_To_Mars__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=-1.1

<region>
sample=Mission_To_Mars__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-2.3

<region>
sample=Mission_To_Mars__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-4.4
