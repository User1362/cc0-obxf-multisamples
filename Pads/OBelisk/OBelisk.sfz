// OBelisk — multisample render of a CC0 OB-Xf patch (Pads). See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=OBelisk__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=-3.4

<region>
sample=OBelisk__48.flac
lokey=43 hikey=54 pitch_keycenter=48
volume=-3.9

<region>
sample=OBelisk__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=-4.6

<region>
sample=OBelisk__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-8.0

<region>
sample=OBelisk__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-4.2
