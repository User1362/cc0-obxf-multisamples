lokey=43 hikey=54 pitch_keycenter=48
volume=-3.0

<region>
sample=Blastine__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=-0.8

<region>
sample=Blastine__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-1.5

<region>
sample=Blastine__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-0.0
