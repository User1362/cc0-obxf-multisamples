// Xmodec — multisample render of a CC0 OB-Xf patch (Basses). See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=Xmodec__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=1.8

<region>
sample=Xmodec__48.flac
lokey=43 hikey=54 pitch_keycenter=48
volume=1.4

<region>
sample=Xmodec__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=1.2

<region>
sample=Xmodec__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=1.2

<region>
sample=Xmodec__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=1.4
