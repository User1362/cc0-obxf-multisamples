lokey=43 hikey=54 pitch_keycenter=48
volume=-2.2

<region>
sample=Back_To_The_Future__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=-2.1

<region>
sample=Back_To_The_Future__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-1.4

<region>
sample=Back_To_The_Future__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-0.1
