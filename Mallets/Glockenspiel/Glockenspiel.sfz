volume=14.0

<region>
sample=Glockenspiel__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=13.8

<region>
sample=Glockenspiel__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=16.0

<region>
sample=Glockenspiel__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=17.2
