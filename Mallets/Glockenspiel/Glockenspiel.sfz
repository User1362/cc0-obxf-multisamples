// Glockenspiel — multisample render of a CC0 OB-Xf patch (Mallets). See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=Glockenspiel__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=12.8

<region>
sample=Glockenspiel__48.flac
