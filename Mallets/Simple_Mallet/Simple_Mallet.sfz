volume=-3.5

<region>
sample=Simple_Mallet__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=-3.5

<region>
sample=Simple_Mallet__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=-4.3

<region>
sample=Simple_Mallet__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-3.4
