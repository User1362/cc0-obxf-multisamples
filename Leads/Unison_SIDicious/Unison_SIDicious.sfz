// Unison SIDicious — multisample render of a CC0 OB-Xf patch (Leads). See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=Unison_SIDicious__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=-2.0

<region>
sample=Unison_SIDicious__48.flac
lokey=43 hikey=54 pitch_keycenter=48
volume=-4.2

<region>
sample=Unison_SIDicious__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=-2.3

<region>
sample=Unison_SIDicious__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=0.0

<region>
sample=Unison_SIDicious__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=-3.1
