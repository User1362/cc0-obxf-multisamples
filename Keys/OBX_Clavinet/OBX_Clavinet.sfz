// OBX Clavinet — multisample render of a CC0 OB-Xf patch (Keys). See SOURCES.md.
<global>
ampeg_release=0.25
loop_mode=no_loop

<region>
sample=OBX_Clavinet__36.flac
lokey=0 hikey=42 pitch_keycenter=36
volume=3.7

<region>
sample=OBX_Clavinet__48.flac
lokey=43 hikey=54 pitch_keycenter=48
volume=7.0

<region>
sample=OBX_Clavinet__60.flac
lokey=55 hikey=66 pitch_keycenter=60
volume=6.5

<region>
sample=OBX_Clavinet__72.flac
lokey=67 hikey=78 pitch_keycenter=72
volume=5.4

<region>
sample=OBX_Clavinet__84.flac
lokey=79 hikey=127 pitch_keycenter=84
volume=6.0
